rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    //database validation: usernames must be 3-20 letters, numbers or _
    function validUsername(username) {
      return username is string && username.matches('^[A-Za-z0-9_]{3,20}$');
    }

    //every saved game must have only these fields, the right types and exactly 10 countries
    function validGame(game) {
      return game.keys().hasOnly(['ownerId', 'status', 'human', 'round', 'turn', 'reserve', 'nations', 'attacked', 'war', 'news', 'roll', 'createdAt', 'updatedAt'])
        && game.status in ['waiting', 'playing', 'won', 'lost']
        && game.human is int && game.human >= 0 && game.human < 10
        && game.turn is int && game.turn >= 0 && game.turn < 10
        && game.round is int && game.round >= 1
        && game.reserve is int && game.reserve >= 0
        && game.nations is list && game.nations.size() == 10
        && (!('attacked' in game) || game.attacked is bool)
        && (!('war' in game) || game.war == null || (game.war is map && game.war.from is int && game.war.to is int))
        && (!('news' in game) || game.news == null || game.news is map)
        && game.updatedAt == request.time;
    }

    match /countries/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['username', 'createdAt'])
        && validUsername(request.resource.data.username)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower()));
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['username', 'createdAt']);
      allow delete: if false;
    }

    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn()
        && name.matches('^[a-z0-9_]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow update, delete: if false;
    }

    match /games/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['waiting', 'playing']
        && request.resource.data.createdAt == request.time
        && validGame(request.resource.data);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && resource.data.status in ['waiting', 'playing']
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.human == resource.data.human
        && request.resource.data.createdAt == resource.data.createdAt
        && validGame(request.resource.data);
      allow delete: if false;
    }
  }
}
